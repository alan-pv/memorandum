[node name="HelpText" type="Label" parent="HelpPanel/Center/Panel/VBox" unique_id=656175952]
layout_mode = 2
text = "The cards start face down.

On your turn you flip cards until you complete a group: as many cards with the same number as the difficulty says (2, 3, 4...).

If the group is right you take it and play again. If you miss, the cards flip back and it is your rival's turn.

Whoever collects the most groups once the table is empty wins."
autowrap_mode = 3

