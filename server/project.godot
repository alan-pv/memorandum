; Engine configuration file.
; Standalone relay server. Open this folder as its own Godot project.

config_version=5

[application]

config/name="Godot Room Relay"
config/description="Game-agnostic WebSocket relay: rooms, passwords and message forwarding."
run/main_scene="res://server_main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Net="*res://room_server.gd"

[rendering]

renderer/rendering_method="gl_compatibility"
